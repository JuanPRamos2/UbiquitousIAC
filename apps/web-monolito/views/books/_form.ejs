<% const selectedAuthors = (book.authors || []).map((item) => Number(item.author_id || item.id)); %>
<% const selectedGenres = (book.genres || []).map((item) => Number(item.genre_id || item.id)); %>

<div class="form-row">
  <div>
    <label for="isbn">ISBN</label>
    <input type="text" id="isbn" name="isbn" value="<%= book.isbn || '' %>" required />
  </div>
  <div>
    <label for="title">Título</label>
    <input type="text" id="title" name="title" value="<%= book.title || '' %>" required />
  </div>
</div>

<div class="form-row">
  <div>
    <label for="publication_year">Año</label>
    <input type="number" id="publication_year" name="publication_year" min="1450" max="2100" value="<%= book.publication_year || '' %>" required />
  </div>
  <div>
    <label for="price">Precio</label>
    <input type="number" step="0.01" min="0" id="price" name="price" value="<%= book.price || '' %>" required />
  </div>
</div>

<div class="form-row">
  <div>
    <label for="stock">Stock</label>
    <input type="number" min="0" id="stock" name="stock" value="<%= book.stock || 0 %>" required />
  </div>
  <div>
    <label for="format_id">Formato</label>
    <select id="format_id" name="format_id" required>
      <% formats.forEach((format) => { %>
        <option value="<%= format.id %>" <%= Number(format.id) === Number(book.format_id) ? 'selected' : '' %>><%= format.name %></option>
      <% }) %>
    </select>
  </div>
</div>

<div class="form-row">
  <div>
    <label for="category_id">Categoría</label>
    <select id="category_id" name="category_id" required>
      <% categories.forEach((category) => { %>
        <option value="<%= category.id %>" <%= Number(category.id) === Number(book.category_id) ? 'selected' : '' %>><%= category.name %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <label for="images">Imágenes (JPG, PNG, WebP · máx. 5 MB)</label>
    <input type="file" id="images" name="images" multiple accept="image/png,image/jpeg,image/webp" />
    <label for="image_alt">Texto alternativo de las nuevas imágenes</label>
    <input type="text" id="image_alt" name="image_alt" />
    <label class="inline-check">
      <input type="checkbox" name="cover_index" value="0" /> Marcar la primera imagen nueva como portada
    </label>
  </div>
</div>

<div class="form-row">
  <div>
    <label>Autores (varios)</label>
    <select name="author_ids" multiple size="8">
      <% authors.forEach((author) => { %>
        <option value="<%= author.id %>" <%= selectedAuthors.includes(Number(author.id)) ? 'selected' : '' %>><%= author.full_name %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <label>Géneros (varios)</label>
    <select name="genre_ids" multiple size="8">
      <% genres.forEach((genre) => { %>
        <option value="<%= genre.id %>" <%= selectedGenres.includes(Number(genre.id)) ? 'selected' : '' %>><%= genre.name %></option>
      <% }) %>
    </select>
  </div>
</div>

<label for="description">Descripción</label>
<textarea id="description" name="description"><%= book.description || '' %></textarea>
