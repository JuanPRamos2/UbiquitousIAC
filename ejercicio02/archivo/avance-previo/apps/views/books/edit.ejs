<%- include('../partials/header') %>
<section class="card">
  <h1>Editar libro</h1>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form action="/books/<%= book.id %>?_method=PUT" method="POST" enctype="multipart/form-data">
    <div class="form-row">
      <div><label for="isbn">ISBN</label><input id="isbn" name="isbn" value="<%= book.isbn %>" required /></div>
      <div><label for="title">Título</label><input id="title" name="title" value="<%= book.title %>" required /></div>
    </div>
    <div class="form-row">
      <div><label for="publication_year">Año</label><input type="number" id="publication_year" name="publication_year" value="<%= book.publication_year %>" required /></div>
      <div><label for="price">Precio</label><input type="number" step="0.01" id="price" name="price" value="<%= book.price %>" required /></div>
    </div>
    <div class="form-row">
      <div><label for="stock">Stock</label><input type="number" id="stock" name="stock" value="<%= book.stock %>" required /></div>
      <div><label for="format_id">Formato</label><select id="format_id" name="format_id" required><% formats.forEach((format) => { %><option value="<%= format.id %>" <%= format.id === book.format_id ? 'selected' : '' %>><%= format.name %></option><% }) %></select></div>
    </div>
    <div class="form-row">
      <div><label for="category_id">Categoría</label><select id="category_id" name="category_id" required><% categories.forEach((category) => { %><option value="<%= category.id %>" <%= category.id === book.category_id ? 'selected' : '' %>><%= category.name %></option><% }) %></select></div>
      <div><label for="images">Agregar imágenes</label><input type="file" id="images" name="images" multiple accept="image/png,image/jpeg,image/webp" /></div>
    </div>
    <div class="form-row">
      <div><label>Autores</label><select name="author_ids" multiple size="6"><% authors.forEach((author) => { %><option value="<%= author.id %>" <%= book.authors.some(item => item.id === author.id) ? 'selected' : '' %>><%= author.full_name %></option><% }) %></select></div>
      <div><label>Géneros</label><select name="genre_ids" multiple size="6"><% genres.forEach((genre) => { %><option value="<%= genre.id %>" <%= book.genres.some(item => item.id === genre.id) ? 'selected' : '' %>><%= genre.name %></option><% }) %></select></div>
    </div>
    <label for="description">Descripción general</label><textarea id="description" name="description"><%= book.description || '' %></textarea>
    <button class="btn" type="submit">Guardar cambios</button>
    <a class="btn" href="/books/<%= book.id %>">Cancelar</a>
  </form>
</section>
<%- include('../partials/footer') %>
