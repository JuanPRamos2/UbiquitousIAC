<%- include('../partials/header') %>
<section class="card">
  <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;">
    <h1>Catálogo de libros</h1>
    <a class="btn" href="/books/new">Nuevo libro</a>
  </div>

  <div class="book-list">
    <% books.forEach((book) => { %>
      <article class="book-item">
        <% const image = book.images && book.images.length ? book.images[0].url : '/placeholder-book.png'; %>
        <img src="<%= image %>" alt="<%= book.title %>" />
        <h3><%= book.title %></h3>
        <p><strong>ISBN:</strong> <%= book.isbn %></p>
        <p><strong>Precio:</strong> $<%= Number(book.price).toFixed(2) %></p>
        <p><strong>Stock:</strong> <%= book.stock %></p>
        <div class="inline-actions">
          <a class="btn" href="/books/<%= book.id %>">Ver</a>
          <a class="btn" href="/books/<%= book.id %>/edit">Editar</a>
          <form action="/books/<%= book.id %>/delete" method="POST">
            <button class="danger-btn" type="submit">Eliminar</button>
          </form>
        </div>
      </article>
    <% }) %>
  </div>
</section>
<%- include('../partials/footer') %>
