<%- include('../partials/header') %>
<section class="card">
  <h1>Registrar nuevo libro</h1>
  <% if (error) { %>
    <div class="error"><%= error %></div>
  <% } %>

  <form action="/books" method="POST" enctype="multipart/form-data">
    <div class="form-row">
      <div>
        <label for="isbn">ISBN</label>
        <input type="text" id="isbn" name="isbn" required />
      </div>
      <div>
        <label for="title">Título</label>
        <input type="text" id="title" name="title" required />
      </div>
    </div>

    <div class="form-row">
      <div>
        <label for="publication_year">Año</label>
        <input type="number" id="publication_year" name="publication_year" required />
      </div>
      <div>
        <label for="price">Precio</label>
        <input type="number" step="0.01" id="price" name="price" required />
      </div>
    </div>

    <div class="form-row">
      <div>
        <label for="stock">Stock</label>
        <input type="number" id="stock" name="stock" required />
      </div>
      <div>
        <label for="format_id">Formato</label>
        <select id="format_id" name="format_id" required>
          <% formats.forEach((format) => { %>
            <option value="<%= format.id %>"><%= format.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="form-row">
      <div>
        <label for="category_id">Categoría</label>
        <select id="category_id" name="category_id" required>
          <% categories.forEach((category) => { %>
            <option value="<%= category.id %>"><%= category.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label for="images">Imágenes</label>
        <input type="file" id="images" name="images" multiple accept="image/png,image/jpeg,image/webp" />
      </div>
    </div>

    <div class="form-row">
      <div>
        <label>Autores</label>
        <select name="author_ids" multiple size="6">
          <% authors.forEach((author) => { %>
            <option value="<%= author.id %>"><%= author.full_name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label>Géneros</label>
        <select name="genre_ids" multiple size="6">
          <% genres.forEach((genre) => { %>
            <option value="<%= genre.id %>"><%= genre.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="card">
      <h3>Conceptos del libro</h3>
      <% concepts.forEach((concept, index) => { %>
        <div class="form-row">
          <div>
            <label><%= concept.name %></label>
            <input type="hidden" name="concept_ids" value="<%= concept.id %>" />
          </div>
          <div>
            <label>Definición</label>
            <input type="text" name="concept_definitions" placeholder="Definición para <%= concept.name %>" />
          </div>
        </div>
      <% }) %>
    </div>

    <label for="description">Descripción general</label>
    <textarea id="description" name="description"></textarea>

    <button class="btn" type="submit">Guardar libro</button>
  </form>
</section>
<%- include('../partials/footer') %>
