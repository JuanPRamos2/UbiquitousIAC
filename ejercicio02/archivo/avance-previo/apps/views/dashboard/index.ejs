<%- include('../partials/header') %>
<section class="card">
  <h1>Dashboard</h1>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="error"><%= error %></div>
  <% } %>
  <div class="stats">
    <div class="stat">
      <h3>Libros</h3>
      <p><%= stats.books %></p>
    </div>
    <div class="stat">
      <h3>Categorías</h3>
      <p><%= stats.categories %></p>
    </div>
    <div class="stat">
      <h3>Autores</h3>
      <p><%= stats.authors %></p>
    </div>
    <div class="stat">
      <h3>Usuarios</h3>
      <p><%= stats.users %></p>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
