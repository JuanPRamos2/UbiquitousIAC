            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Sin\",\n  \"apellidoPaterno\": \"Captcha\",\n  \"apellidoMaterno\": \"Demo\",\n  \"email\": \"sin.captcha@example.com\",\n  \"password\": \"ClaveSegura26\"\n}"
            },
            "url": "{{login}}/register?format=json"
          }
        },
        {
          "name": "05 POST /register CON captcha (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('registerEmail', 'postman.' + Date.now() + '@example.com');",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('login') + '/captcha?format=json',",
                  "  method: 'GET',",
                  "  header: { Accept: 'application/json' }",
                  "}, (err, res) => {",
                  "  if (err) throw err;",
                  "  const d = res.json();",
                  "  const parts = String(d.question || '').split('+');",
                  "  pm.collectionVariables.set('captchaId', d.captchaId);",
                  "  pm.collectionVariables.set('captchaQuestion', d.question);",
                  "  pm.collectionVariables.set('captchaAnswer', String(Number(parts[0]) + Number(parts[1])));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "if (d.verificationToken) pm.collectionVariables.set('verificationToken', d.verificationToken);",
                  "if (d.notification && d.notification.body && d.notification.body.verificationToken) {",
                  "  pm.collectionVariables.set('verificationToken', d.notification.body.verificationToken);",
                  "}",
                  "pm.test('registro: usuario existe, notificación JSON, correo NO verificado', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(d.format).to.eql('json');",
                  "  pm.expect(d.ok).to.eql(true);",
                  "  pm.expect(d.userExists).to.eql(true);",
                  "  pm.expect(d.user.emailVerified).to.eql(false);",
                  "  pm.expect(d.notification.code).to.eql('EMAIL_VERIFICATION_REQUIRED');",
                  "  pm.expect(d.notification.channel).to.eql('json');",
                  "  pm.expect(d.notification.body.userExists).to.eql(true);",
                  "  pm.expect(d.notification.body.verificationToken).to.be.ok;",
                  "  pm.expect(d.notification.body.verifyUrl).to.include('format=json');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Postman\",\n  \"apellidoPaterno\": \"Prueba\",\n  \"apellidoMaterno\": \"Json\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\",\n  \"captchaId\": \"{{captchaId}}\",\n  \"captchaAnswer\": \"{{captchaAnswer}}\"\n}"
