      "item": [
        {
          "name": "01 GET / índice HATEOAS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.test('JSON HATEOAS del login', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(d.format).to.eql('json');",
                  "  pm.expect(d.service).to.eql('login');",
                  "  pm.expect(d.richardson).to.eql(3);",
                  "  pm.expect(d.sessionMinutes).to.eql(30);",
                  "  pm.expect(d._links.captcha).to.be.ok;",
                  "  pm.expect(d._links.register).to.be.ok;",
                  "  pm.expect(d._links.login).to.be.ok;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{login}}/?format=json"
          }
        },
        {
          "name": "02 GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
