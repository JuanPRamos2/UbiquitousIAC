          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{login}}/health?format=json"
          }
        },
        {
          "name": "03 GET /captcha",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set('captchaId', d.captchaId);",
                  "pm.collectionVariables.set('captchaQuestion', d.question);",
                  "const parts = String(d.question || '').split('+');",
                  "pm.collectionVariables.set('captchaAnswer', String(Number(parts[0]) + Number(parts[1])));",
                  "pm.test('captcha JSON', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(d.format).to.eql('json');",
                  "  pm.expect(d.captchaId).to.be.ok;",
                  "  pm.expect(d.question).to.match(/\\d+ \\+ \\d+/);",
                  "  pm.expect(d.expiresInSeconds).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{login}}/captcha?format=json"
          }
        },
