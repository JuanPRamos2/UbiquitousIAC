PORT=3000
# Puerto en el HOST (si 3000 está ocupado: API_HOST_PORT=3001)
API_HOST_PORT=3000
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_EXPIRES_SEC=900
LOGIN_MAX_INTENTOS=5
REDIS_TTL_CACHE_AGREGADO_SEC=300
REDIS_TTL_LOCK_AGREGADO_SEC=10

# Fuera de Compose, PostgreSQL del contenedor se publica en 5433.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=bienestar_nexum
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

MONGO_URL=mongodb://localhost:27017
MONGO_DB=bienestar_nexum

REDIS_URL=redis://localhost:6379
