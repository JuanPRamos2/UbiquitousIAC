{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexum.com.mx/bienestar/contratos/Reporte.schema.json",
  "title": "Reporte",
  "description": "Metadatos del reporte generado. El contenido se descarga aparte para no mandar miles de filas en cada listado.",
  "properties": {
    "columnas": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "correlacion_id": {
      "type": "string"
    },
    "epsilon_consumido": {
      "description": "Siempre 0. Está en la respuesta a propósito: es la prueba, por reporte, de que generarlo no gastó presupuesto de privacidad.",
      "example": 0,
      "format": "double",
      "type": "number"
    },
    "fecha_generacion": {
      "format": "date-time",
      "type": "string"
    },
    "filas_suprimidas": {
      "description": "Cuántas de las filas van sin valor por supresión. Se informa en los metadatos para que nadie calcule una cobertura con el total y se quede con una impresión equivocada.",
      "type": "integer"
    },
    "generado_por": {
      "pattern": "^USR-[0-9]{5}$",
      "type": "string"
    },
    "nota": {
      "type": "string"
    },
    "parametro": {
      "type": [
        "string",
        "null"
      ]
    },
    "perfil_generador": {
      "type": "string"
    },
    "reporte_id": {
      "pattern": "^RPT-[0-9A-F]{12}$",
      "type": "string"
    },
    "sello_sha256": {
      "description": "SHA-256 del contenido canónico. Permite confrontar el archivo que recibió un tercero contra lo que salió de aquí.",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "tipo": {
      "enum": [
        "TABLERO_CAMPANIA",
        "PARTICIPACION",
        "PRESUPUESTO_EPSILON",
        "SUPRESIONES",
        "INTERVENCIONES",
        "BITACORA_AUDITORIA",
        "RECOMENDACIONES"
      ],
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "total_filas": {
      "type": "integer"
    }
  },
  "type": "object",
  "$defs": {
    "Error": {
      "properties": {
        "error": {
          "properties": {
            "codigo": {
              "description": "Codigo estable; el cliente programa contra esto, no contra el mensaje.",
              "example": "SIN_PERMISO",
              "type": "string"
            },
            "correlacion_id": {
              "example": "a1b2c3d4e5f60718",
              "type": "string"
            },
            "detalles": {
              "items": {
                "properties": {
                  "campo": {
                    "example": "correo",
                    "type": "string"
                  },
                  "problema": {
                    "example": "no es un correo valido",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "mensaje": {
              "example": "El perfil Colaborador no tiene el permiso requerido.",
              "type": "string"
            }
          },
          "required": [
            "codigo",
            "mensaje"
          ],
          "type": "object"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "Paginacion": {
      "properties": {
        "pagina": {
          "example": 1,
          "type": "integer"
        },
        "tamano": {
          "example": 20,
          "type": "integer"
        },
        "tiene_anterior": {
          "example": false,
          "type": "boolean"
        },
        "tiene_siguiente": {
          "example": true,
          "type": "boolean"
        },
        "total": {
          "example": 143,
          "type": "integer"
        },
        "total_paginas": {
          "example": 8,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "SolicitudReporte": {
      "properties": {
        "parametro": {
          "description": "El valor del parámetro que declara el tipo. TABLERO_CAMPANIA lo exige; los demás lo admiten como filtro.",
          "type": [
            "string",
            "null"
          ]
        },
        "tipo": {
          "enum": [
            "TABLERO_CAMPANIA",
            "PARTICIPACION",
            "PRESUPUESTO_EPSILON",
            "SUPRESIONES",
            "INTERVENCIONES",
            "BITACORA_AUDITORIA",
            "RECOMENDACIONES"
          ],
          "type": "string"
        }
      },
      "required": [
        "tipo"
      ],
      "type": "object"
    },
    "SolicitudVerificar": {
      "properties": {
        "sello_sha256": {
          "pattern": "^[0-9a-fA-F]{64}$",
          "type": "string"
        }
      },
      "required": [
        "sello_sha256"
      ],
      "type": "object"
    },
    "TipoReporte": {
      "properties": {
        "formatos": {
          "items": {
            "enum": [
              "json",
              "csv",
              "xml"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "nota": {
          "description": "Qué significan las columnas y cómo NO debe leerse el reporte. Va en el contrato porque un CSV sin esta nota invita a tratar un valor con ruido como si fuera el promedio real de la unidad.",
          "type": "string"
        },
        "parametro": {
          "description": "Nombre del parámetro que admite (campania_id, unidad_organizacional_id, accion) o nulo si no admite ninguno.",
          "type": [
            "string",
            "null"
          ]
        },
        "parametro_obligatorio": {
          "type": "boolean"
        },
        "permisos": {
          "description": "Basta tener uno de ellos.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tipo": {
          "enum": [
            "TABLERO_CAMPANIA",
            "PARTICIPACION",
            "PRESUPUESTO_EPSILON",
            "SUPRESIONES",
            "INTERVENCIONES",
            "BITACORA_AUDITORIA",
            "RECOMENDACIONES"
          ],
          "type": "string"
        },
        "titulo": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "Verificacion": {
      "properties": {
        "coincide": {
          "description": "El sello recibido es el del reporte.",
          "type": "boolean"
        },
        "integro": {
          "description": "El sello recalculado sobre las filas guardadas sigue dando el sello registrado: el documento almacenado no fue alterado.",
          "type": "boolean"
        },
        "mensaje": {
          "type": "string"
        },
        "reporte_id": {
          "type": "string"
        },
        "sello_registrado": {
          "type": "string"
        }
      },
      "type": "object"
    }
  }
}
