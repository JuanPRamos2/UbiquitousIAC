# Ambiente: staging
# Las contraseñas reales NO se escriben aquí. Se inyectan desde
# Secret Manager al desplegar, con scripts/publicar.sh.

APP_AMBIENTE=staging
VERSION=            # obligatoria: etiqueta de la imagen, p. ej. 1.2.0

PG_BASE=bienestar
PG_SUPERUSUARIO=postgres
PG_CLAVE_SUPER=     # desde Secret Manager
PG_USUARIO=bienestar_app
PG_CLAVE=           # desde Secret Manager

REDIS_MAXMEMORY=128mb
GUNICORN_WORKERS=1
NIVEL_BITACORA=INFO
MOSTRAR_ERRORES=false
