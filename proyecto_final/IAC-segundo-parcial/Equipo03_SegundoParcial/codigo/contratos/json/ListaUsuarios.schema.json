{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexum.com.mx/bienestar/contratos/ListaUsuarios.schema.json",
  "title": "ListaUsuarios",
  "description": "Generado desde el contrato OpenAPI de users-service. No editar a mano: ejecutar contratos/generar_json.py.",
  "properties": {
    "paginacion": {
      "$ref": "#/$defs/Paginacion"
    },
    "usuarios": {
      "items": {
        "$ref": "#/$defs/Usuario"
      },
      "type": "array"
    }
  },
  "type": "object",
  "$defs": {
    "Error": {
      "properties": {
        "error": {
          "properties": {
            "codigo": {
              "description": "Codigo estable; el cliente programa contra esto, no contra el mensaje.",
              "example": "SIN_PERMISO",
              "type": "string"
            },
            "correlacion_id": {
              "example": "a1b2c3d4e5f60718",
              "type": "string"
            },
            "detalles": {
              "items": {
                "properties": {
                  "campo": {
                    "example": "correo",
                    "type": "string"
                  },
                  "problema": {
                    "example": "no es un correo valido",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "mensaje": {
              "example": "El perfil Colaborador no tiene el permiso requerido.",
              "type": "string"
            }
          },
          "required": [
            "codigo",
            "mensaje"
          ],
          "type": "object"
        }
      },
      "required": [
        "error"
      ],
      "type": "object"
    },
    "Paginacion": {
      "properties": {
        "pagina": {
          "example": 1,
          "type": "integer"
        },
        "tamano": {
          "example": 20,
          "type": "integer"
        },
        "tiene_anterior": {
          "example": false,
          "type": "boolean"
        },
        "tiene_siguiente": {
          "example": true,
          "type": "boolean"
        },
        "total": {
          "example": 143,
          "type": "integer"
        },
        "total_paginas": {
          "example": 8,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "SolicitudAlta": {
      "properties": {
        "apellido_materno": {
          "type": "string"
        },
        "apellido_paterno": {
          "minLength": 2,
          "type": "string"
        },
        "contrasena": {
          "description": "Se cifra con crypt() en la base; el texto plano no se guarda en ningun momento.",
          "format": "password",
          "minLength": 8,
          "type": "string"
        },
        "correo": {
          "format": "email",
          "type": "string"
        },
        "nombre": {
          "minLength": 2,
          "type": "string"
        },
        "perfil_id": {
          "example": 1,
          "type": "integer"
        },
        "unidad_alcance_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "usuario_id": {
          "pattern": "^USR-[0-9]{5}$",
          "type": "string"
        }
      },
      "required": [
        "usuario_id",
        "correo",
        "nombre",
        "apellido_paterno",
        "contrasena",
        "perfil_id"
      ],
      "type": "object"
    },
    "Usuario": {
      "properties": {
        "activo": {
          "type": "boolean"
        },
        "apellido_materno": {
          "type": [
            "string",
            "null"
          ]
        },
        "apellido_paterno": {
          "example": "Solis",
          "type": "string"
        },
        "correo": {
          "format": "email",
          "type": "string"
        },
        "fecha_ultimo_acceso": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "nombre": {
          "example": "Mariana",
          "type": "string"
        },
        "perfil": {
          "type": [
            "string",
            "null"
          ]
        },
        "perfil_id": {
          "example": 3,
          "type": [
            "integer",
            "null"
          ]
        },
        "unidad_alcance_id": {
          "description": "null = alcance en toda la organizacion.",
          "type": [
            "string",
            "null"
          ]
        },
        "usuario_id": {
          "example": "USR-00003",
          "pattern": "^USR-[0-9]{5}$",
          "type": "string"
        }
      },
      "type": "object"
    }
  }
}
