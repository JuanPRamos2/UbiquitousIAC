# Ambiente: developer
# Cópialo como developer.env y ajusta lo que necesites.
# Este archivo SÍ puede tener contraseñas triviales: los datos son sintéticos.

APP_AMBIENTE=developer
VERSION=local

PG_BASE=bienestar
PG_SUPERUSUARIO=postgres
PG_CLAVE_SUPER=desarrollo_local
PG_USUARIO=bienestar_app
PG_CLAVE=desarrollo_local

REDIS_MAXMEMORY=256mb
GUNICORN_WORKERS=1
NIVEL_BITACORA=DEBUG
MOSTRAR_ERRORES=true

# ---------------------------------------------------------------- segundo parcial
MONGO_BASE=bienestar

# El MISMO secreto para el sistema web y para los ocho microservicios: por
# eso un token emitido en cualquiera sirve en los demas y un logout revoca
# en todos. En production esta variable es obligatoria y no tiene valor por
# omision; aqui lo tiene para que el equipo levante el sistema sin
# configurar nada.
JWT_SECRETO=secreto-solo-para-developer-32-bytes
JWT_MINUTOS=15

# Cache de catalog-service. Un catalogo cambia pocas veces al mes, asi que
# cinco minutos es conservador; se invalida igual en cada mutacion.
CATALOGO_CACHE_TTL_SEG=300

# Tope del cuerpo de una peticion de carga de evidencias, en bytes.
# Se aplica ANTES de cualquier validacion: sin el, Flask leeria en memoria
# todo lo que le manden antes de llegar a comprobar el formato.
EVIDENCIA_TAMANO_MAXIMO=8388608

# Almacen de archivos de evidencia. En developer es una carpeta; en
# production, el punto de montaje del bucket de objetos. El codigo no
# cambia: cambia esta variable.
ALMACEN_EVIDENCIAS=/var/lib/bienestar/evidencias

# A donde llama el sistema web. Si un servicio no responde, el portal cae a
# PostgreSQL y sigue operando (salvo la bandeja de notificaciones, cuyo dato
# vive solo en MongoDB: ahi la pantalla lo dice en lugar de fingir una lista
# vacia). La pantalla /administracion/servicios permite demostrarlo
# apagandolos durante la revision.
AUTH_SERVICE_URL=http://auth-service:8000
USERS_SERVICE_URL=http://users-service:8000
CATALOG_SERVICE_URL=http://catalog-service:8000
MAIN_PROCESS_SERVICE_URL=http://main-process-service:8000
DOCUMENTS_SERVICE_URL=http://documents-service:8000
NOTIFICATIONS_SERVICE_URL=http://notifications-service:8000
QUERIES_SERVICE_URL=http://queries-service:8000
REPORTS_SERVICE_URL=http://reports-service:8000

# Cuanto espera el sistema web a un microservicio antes de caer a la base.
# 2.5 s es deliberado: por debajo, una consulta lenta pero correcta se
# tomaria por caida; por encima, el operador mira una pantalla congelada.
MICROSERVICIO_TIMEOUT=2.5
