# Ambiente: production
# Ninguna contraseña vive en este archivo ni en el repositorio.
# La contraseña del superusuario llega por archivo de secreto de Docker;
# la de la aplicación se inyecta desde Secret Manager al desplegar.

APP_AMBIENTE=production
VERSION=            # obligatoria: sin versión, el despliegue falla a propósito

PG_BASE=bienestar
PG_SUPERUSUARIO=postgres
PG_USUARIO=bienestar_app
PG_CLAVE=           # desde Secret Manager

REDIS_MAXMEMORY=768mb
GUNICORN_WORKERS=4
API_REPLICAS=1      # subir a 2 cuando se rebasen las 117 peticiones/s medidas
NIVEL_BITACORA=INFO
MOSTRAR_ERRORES=false

# ---------------------------------------------------------------- segundo parcial
MONGO_BASE=bienestar

# Sin valor por omisión, y a propósito: en developer hay uno trivial para
# que el equipo levante el sistema sin configurar nada, pero aquí la falta
# de esta variable detiene el arranque. Un secreto de firma por omisión en
# production significaría que cualquiera que lea el repositorio puede
# emitir tokens válidos.
JWT_SECRETO=           # desde Secret Manager
JWT_MINUTOS=15

CATALOGO_CACHE_TTL_SEG=300
EVIDENCIA_TAMANO_MAXIMO=8388608

# Punto de montaje del bucket de objetos. No es una carpeta del contenedor:
# un archivo de evidencia que viviera en el sistema de archivos del
# contenedor desaparecería en el siguiente despliegue.
ALMACEN_EVIDENCIAS=/mnt/evidencias

# Nombres de servicio de la red privada. No se publica ningún puerto en
# production: el acceso desde fuera pasa por el proxy, y estas direcciones
# solo resuelven dentro de la red interna.
AUTH_SERVICE_URL=http://auth-service:8000
USERS_SERVICE_URL=http://users-service:8000
CATALOG_SERVICE_URL=http://catalog-service:8000
MAIN_PROCESS_SERVICE_URL=http://main-process-service:8000
DOCUMENTS_SERVICE_URL=http://documents-service:8000
NOTIFICATIONS_SERVICE_URL=http://notifications-service:8000
QUERIES_SERVICE_URL=http://queries-service:8000
REPORTS_SERVICE_URL=http://reports-service:8000
MICROSERVICIO_TIMEOUT=2.5
