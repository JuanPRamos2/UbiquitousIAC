<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tipos XML comunes a todos los microservicios de Bienestar Nexum.

  Este archivo define lo que se repite en todas las respuestas: el sobre de
  error, la paginación y los tipos simples con restricción. Los esquemas de
  cada servicio lo importan en lugar de volver a declararlo, de modo que un
  cambio en la forma del error se haga en un solo lugar.

  Decisiones que conviene entender al leerlo:

  - Los campos que pueden venir sin dato se declaran nillable="true" y el
    servicio los marca con xsi:nil. Es distinto de una cadena vacía: un
    valor agregado suprimido por el umbral de privacidad NO es cero ni
    cadena vacía, es "no hay dato publicable".
  - Los identificadores llevan patrón. Validar la forma en el esquema
    permite rechazar una solicitud mal armada antes de que llegue a la
    base de datos.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://nexum.com.mx/bienestar/v1"
           targetNamespace="http://nexum.com.mx/bienestar/v1"
           elementFormDefault="qualified"
           version="1.0">

  <!-- ===================== tipos simples con restricción ================= -->

  <xs:simpleType name="IdUsuario">
    <xs:annotation>
      <xs:documentation>Identificador de usuario. Forma USR-00000.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="USR-[0-9]{5}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IdSeudonimo">
    <xs:annotation>
      <xs:documentation>
        Seudónimo del colaborador. Es el ÚNICO identificador de persona que
        puede viajar en una respuesta: nunca el identificador de empleado.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="SEUD-[0-9]{5}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IdUnidad">
    <xs:restriction base="xs:string">
      <xs:pattern value="UO-[A-Z0-9-]{2,36}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IdCampania">
    <xs:restriction base="xs:string">
      <xs:pattern value="CAMP-[0-9]{4}-[A-Z0-9]{1,8}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IdDocumento">
    <xs:restriction base="xs:string">
      <xs:pattern value="DOC-[0-9A-F]{12}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IdNotificacion">
    <xs:restriction base="xs:string">
      <xs:pattern value="NTF-[0-9A-F]{12}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Correo">
    <xs:restriction base="xs:string">
      <xs:pattern value="[^@\s]+@[^@\s]+\.[A-Za-z]{2,}"/>
      <xs:maxLength value="180"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CodigoError">
    <xs:annotation>
      <xs:documentation>
        Código estable del error. El cliente programa contra esto; el
        mensaje puede cambiar de redacción sin romper a nadie.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z_]{3,40}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoDocumento">
    <xs:restriction base="xs:string">
      <xs:enumeration value="EVIDENCIA_CONSENTIMIENTO"/>
      <xs:enumeration value="AVISO_PRIVACIDAD"/>
      <xs:enumeration value="REPORTE_ORGANIZACIONAL"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoNotificacion">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CAMPANIA_ABIERTA"/>
      <xs:enumeration value="RECORDATORIO_ENCUESTA"/>
      <xs:enumeration value="CONDICION_DETECTADA"/>
      <xs:enumeration value="PLAN_APROBADO"/>
      <xs:enumeration value="CONSENTIMIENTO_POR_VENCER"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ========================== sobre de error ========================== -->

  <xs:complexType name="DetalleError">
    <xs:sequence>
      <xs:element name="campo"    type="xs:string"/>
      <xs:element name="problema" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Error">
    <xs:sequence>
      <xs:element name="codigo"  type="CodigoError"/>
      <xs:element name="mensaje" type="xs:string"/>
      <xs:element name="detalles" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="detalle" type="DetalleError"
                        minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="correlacion_id" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="error_respuesta">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="error" type="Error"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ============================ paginación ============================ -->

  <xs:complexType name="Paginacion">
    <xs:sequence>
      <xs:element name="pagina"          type="xs:positiveInteger"/>
      <xs:element name="tamano"          type="xs:positiveInteger"/>
      <xs:element name="total"           type="xs:nonNegativeInteger"/>
      <xs:element name="total_paginas"   type="xs:positiveInteger"/>
      <xs:element name="tiene_siguiente" type="xs:boolean"/>
      <xs:element name="tiene_anterior"  type="xs:boolean"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
