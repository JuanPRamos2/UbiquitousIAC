<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="busqueda">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="search" type="xs:string" minOccurs="0"/>
        <xs:element name="accion" type="xs:string" minOccurs="0"/>
        <xs:element name="resultado" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="EXITO"/>
              <xs:enumeration value="RECHAZADO"/>
              <xs:enumeration value="GRUPO_INSUFICIENTE"/>
              <xs:enumeration value="PRESUPUESTO_AGOTADO"/>
              <xs:enumeration value="ERROR_TECNICO"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="desde" type="xs:date" minOccurs="0"/>
        <xs:element name="hasta" type="xs:date" minOccurs="0"/>
        <xs:element name="page" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:integer">
              <xs:minInclusive value="1"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="limit" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:integer">
              <xs:minInclusive value="1"/>
              <xs:maxInclusive value="100"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
