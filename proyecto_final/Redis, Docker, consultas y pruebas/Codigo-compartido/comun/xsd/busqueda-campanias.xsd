<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="busqueda">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="search" type="xs:string" minOccurs="0"/>
        <xs:element name="estado" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="BORRADOR"/>
              <xs:enumeration value="ABIERTA"/>
              <xs:enumeration value="CERRADA"/>
              <xs:enumeration value="CANCELADA"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="page" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:integer">
              <xs:minInclusive value="1"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="limit" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:integer">
              <xs:minInclusive value="1"/>
              <xs:maxInclusive value="100"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="sort" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="nombre"/>
              <xs:enumeration value="fecha_inicio"/>
              <xs:enumeration value="secuencia"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="order" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="asc"/>
              <xs:enumeration value="desc"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
