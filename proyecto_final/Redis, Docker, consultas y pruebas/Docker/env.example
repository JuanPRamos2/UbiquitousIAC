PORT=3000
# Puerto en el HOST (si 3000 está ocupado: API_HOST_PORT=3001)
API_HOST_PORT=3000
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_EXPIRES_SEC=900
LOGIN_MAX_INTENTOS=5
REDIS_TTL_CACHE_AGREGADO_SEC=300
REDIS_TTL_LOCK_AGREGADO_SEC=10

# Fuera de Compose, PostgreSQL del contenedor se publica en 5433.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=bienestar_nexum
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

MONGO_URL=mongodb://localhost:27017
MONGO_DB=bienestar_nexum

REDIS_URL=redis://localhost:6379

# Microservicios del integrante 4. Dentro de Compose estos hosts NO se usan:
# los contenedores hablan con postgres, mongo y redis.
QUERIES_HOST_PORT=3010
REPORTS_HOST_PORT=3020
POSTGRES_HOST_PORT=5433
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=
JWT_PUBLIC_KEY=
JWT_REQUIRE_SESSION=true
CACHE_TTL_SEC=60
REDIS_TTL_LOCK_SEC=10
REDIS_TTL_CONTEXTO_SEC=60
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SEC=60
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
QUERIES_PUBLIC_ORIGIN=http://127.0.0.1:3010
REPORTS_PUBLIC_ORIGIN=http://127.0.0.1:3020
