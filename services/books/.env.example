DB_HOST=localhost
DB_PORT=5432
DB_NAME=library_db
DB_USER=soap_user
DB_PASSWORD=

SOAP_HOST=0.0.0.0
SOAP_PORT=5001

# La misma JWT_SECRET_KEY que services/login. Books solo verifica el JWT.
JWT_SECRET_KEY=libreria-jwt-secreto-compartido
JWT_PASSWORD=libreria-jwt-compartida
REDIS_URL=redis://:libreria-redis@127.0.0.1:6379/0
BOOKS_CACHE_TTL=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

SOAP_DEMO=1

# WS-Security UsernameToken para ObtenerEstadisticasPorModelo.
# En modo demostración la clave de laboratorio es "laboratorio".
# No publiques este archivo. En un servidor real genera el hash con:
# python -c "from soap.security import hash_password; print(hash_password('tu-clave'))"
SOAP_STATS_USERNAME=soap_stats
SOAP_STATS_PASSWORD_HASH=
