<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
    name="LibraryClassifier"
    targetNamespace="http://udem.edu.mx/iac/library-classifier"
    xmlns:tns="http://udem.edu.mx/iac/library-classifier"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <wsdl:types>
    <xsd:schema
        targetNamespace="http://udem.edu.mx/iac/library-classifier"
        elementFormDefault="qualified">

      <xsd:simpleType name="CloudModelo">
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="IaaS"/>
          <xsd:enumeration value="PaaS"/>
          <xsd:enumeration value="SaaS"/>
          <xsd:enumeration value="FaaS"/>
        </xsd:restriction>
      </xsd:simpleType>

      <xsd:complexType name="ConceptoPendiente">
        <xsd:sequence>
          <xsd:element name="conceptId" type="xsd:int"/>
          <xsd:element name="conceptName" type="xsd:string"/>
          <xsd:element name="definition" type="xsd:string"/>
          <xsd:element name="isbn" type="xsd:string"/>
          <xsd:element name="bookTitle" type="xsd:string"/>
          <xsd:element name="categoryName" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:complexType name="EstadisticaModelo">
        <xsd:sequence>
          <xsd:element name="modelo" type="tns:CloudModelo"/>
          <xsd:element name="cantidad" type="xsd:int"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:element name="ObtenerConceptosPendientes">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="correo" type="xsd:string"/>
            <xsd:element name="tipoCliente" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="ObtenerConceptosPendientesResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="total" type="xsd:int"/>
            <xsd:element name="concepto" type="tns:ConceptoPendiente" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="RegistrarClasificacion">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="nombre" type="xsd:string"/>
            <xsd:element name="apellidos" type="xsd:string"/>
            <xsd:element name="correo" type="xsd:string"/>
            <xsd:element name="conceptId" type="xsd:int"/>
            <xsd:element name="isbn" type="xsd:string"/>
            <xsd:element name="modelo" type="tns:CloudModelo"/>
            <xsd:element name="tipoCliente" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="RegistrarClasificacionResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="clasificacionId" type="xsd:int"/>
            <xsd:element name="mensaje" type="xsd:string"/>
            <xsd:element name="modelo" type="tns:CloudModelo"/>
            <xsd:element name="fecha" type="xsd:dateTime"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ObtenerProgresoUsuario">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="correo" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="ObtenerProgresoUsuarioResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="correo" type="xsd:string"/>
            <xsd:element name="nombreCompleto" type="xsd:string"/>
            <xsd:element name="clasificados" type="xsd:int"/>
            <xsd:element name="pendientes" type="xsd:int"/>
            <xsd:element name="totalCatalogo" type="xsd:int"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="ObtenerEstadisticasPorModelo">
        <xsd:complexType>
          <xsd:sequence/>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="ObtenerEstadisticasPorModeloResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="item" type="tns:EstadisticaModelo" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="ObtenerConceptosPendientesRequest">
    <wsdl:part name="parameters" element="tns:ObtenerConceptosPendientes"/>
  </wsdl:message>
  <wsdl:message name="ObtenerConceptosPendientesResponse">
    <wsdl:part name="parameters" element="tns:ObtenerConceptosPendientesResponse"/>
  </wsdl:message>

  <wsdl:message name="RegistrarClasificacionRequest">
    <wsdl:part name="parameters" element="tns:RegistrarClasificacion"/>
  </wsdl:message>
  <wsdl:message name="RegistrarClasificacionResponse">
    <wsdl:part name="parameters" element="tns:RegistrarClasificacionResponse"/>
  </wsdl:message>

  <wsdl:message name="ObtenerProgresoUsuarioRequest">
    <wsdl:part name="parameters" element="tns:ObtenerProgresoUsuario"/>
  </wsdl:message>
  <wsdl:message name="ObtenerProgresoUsuarioResponse">
    <wsdl:part name="parameters" element="tns:ObtenerProgresoUsuarioResponse"/>
  </wsdl:message>

  <wsdl:message name="ObtenerEstadisticasPorModeloRequest">
    <wsdl:part name="parameters" element="tns:ObtenerEstadisticasPorModelo"/>
  </wsdl:message>
  <wsdl:message name="ObtenerEstadisticasPorModeloResponse">
    <wsdl:part name="parameters" element="tns:ObtenerEstadisticasPorModeloResponse"/>
  </wsdl:message>

  <wsdl:portType name="LibraryClassifierPortType">
    <wsdl:operation name="ObtenerConceptosPendientes">
      <wsdl:input message="tns:ObtenerConceptosPendientesRequest"/>
      <wsdl:output message="tns:ObtenerConceptosPendientesResponse"/>
    </wsdl:operation>
    <wsdl:operation name="RegistrarClasificacion">
      <wsdl:input message="tns:RegistrarClasificacionRequest"/>
      <wsdl:output message="tns:RegistrarClasificacionResponse"/>
    </wsdl:operation>
    <wsdl:operation name="ObtenerProgresoUsuario">
      <wsdl:input message="tns:ObtenerProgresoUsuarioRequest"/>
      <wsdl:output message="tns:ObtenerProgresoUsuarioResponse"/>
    </wsdl:operation>
    <wsdl:operation name="ObtenerEstadisticasPorModelo">
      <wsdl:documentation>Requiere WS-Security UsernameToken en el Header.</wsdl:documentation>
      <wsdl:input message="tns:ObtenerEstadisticasPorModeloRequest"/>
      <wsdl:output message="tns:ObtenerEstadisticasPorModeloResponse"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="LibraryClassifierBinding" type="tns:LibraryClassifierPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="ObtenerConceptosPendientes">
      <soap:operation soapAction="http://udem.edu.mx/iac/library-classifier/ObtenerConceptosPendientes"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="RegistrarClasificacion">
      <soap:operation soapAction="http://udem.edu.mx/iac/library-classifier/RegistrarClasificacion"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="ObtenerProgresoUsuario">
      <soap:operation soapAction="http://udem.edu.mx/iac/library-classifier/ObtenerProgresoUsuario"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="ObtenerEstadisticasPorModelo">
      <soap:operation soapAction="http://udem.edu.mx/iac/library-classifier/ObtenerEstadisticasPorModelo"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="LibraryClassifierService">
    <wsdl:documentation>
      Módulo SOAP independiente para clasificar conceptos del catálogo de la librería.
      El endpoint concreto se sustituye al servir el WSDL.
    </wsdl:documentation>
    <wsdl:port name="LibraryClassifierPort" binding="tns:LibraryClassifierBinding">
      <soap:address location="http://localhost:5000/soap"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
